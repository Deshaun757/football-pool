NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Your 10-character Apple Developer Team ID enables iOS universal links.
APPLE_TEAM_ID=
# Comma-separated native WebView origins allowed to call the API.
MOBILE_APP_ORIGINS=capacitor://localhost
MYSQL_URL=mysql://pickem:pickem@localhost:3306/pickem
SESSION_COOKIE_NAME=pickem_session
SESSION_TTL_DAYS=30
ADMIN_EMAIL=commissioner@example.com

# Local MailHog inbox: http://localhost:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# Set these to your mailbox credentials when deploying (leave blank for MailHog).
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@pickem.local
